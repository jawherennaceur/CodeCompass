# Copier ce fichier en .env et remplir les valeurs réelles.
# .env ne doit JAMAIS être commité (voir .gitignore).

# Chemin absolu vers le repo à indexer
REPO_PATH=/chemin/vers/ton/repo

# Clé API Anthropic (pour le routeur Haiku)
ANTHROPIC_API_KEY=sk-ant-...

# Qdrant (valeurs par défaut si tu utilises docker-compose tel quel)
QDRANT_HOST=localhost
QDRANT_PORT=6333
